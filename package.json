{
  "name": "backend_pa_valuetech",
  "version": "1.0.0",
  "description": "Workflow Management Backend",
  "main": "./server.js",
  "type": "module",
  "engines": {
    "node": "22.12.0 || >=24"
  },
  "scripts": {
    "start": "node ./server.js",
    "dev": "nodemon ./server.js",
    "//postinstall": "Auto-runs after npm install — generates Prisma Client into src/generated/prisma from schema/",
    "postinstall": "prisma generate",
    "//migrate": "Run manually when schema changes — creates a SQL migration file and applies it to the DB",
    "migrate": "prisma migrate dev",
    "studio": "npx prisma studio"
  },
  "license": "ISC",
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "nodemon": "^3.1.14",
    "prisma": "^7.8.0"
  },
  "allowScripts": {
    "@prisma/engines@7.8.0": true,
    "bcrypt@6.0.0": true,
    "prisma@7.8.0": true
  }
}
