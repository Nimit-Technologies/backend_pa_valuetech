PORT=5000

# Supabase connection pooler (Transaction mode, port 6543) — used by the app at runtime
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:[PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres

# Supabase direct connection (port 5432) — used by Prisma migrations only
DIRECT_URL=postgresql://postgres:[PASSWORD]@db.xxxxxxxxxxxx.supabase.co:5432/postgres

JWT_SECRET=replace_with_a_long_random_secret
PEPPER_SECRET=replace_with_a_long_random_secret
SALT_ROUNDS=12

# PII-at-rest encryption (Aadhaar) — see src/utils/encryption.js
# Two distinct 32-byte keys, 64 hex chars each: openssl rand -hex 32
ENCRYPTION_KEY=replace_with_64_hex_chars
BLIND_INDEX_KEY=replace_with_64_hex_chars

ALLOWED_ORIGIN=http://localhost:5173
