PORT=5000

# Supabase connection pooler (Transaction mode, port 6543) — used by the app at runtime
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:[PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres

# Supabase direct connection (port 5432) — used by Prisma migrations only
DIRECT_URL=postgresql://postgres:[PASSWORD]@db.xxxxxxxxxxxx.supabase.co:5432/postgres

JWT_SECRET=replace_with_a_long_random_secret
ALLOWED_ORIGIN=http://localhost:5173
