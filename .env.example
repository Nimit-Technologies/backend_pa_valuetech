# Application
NODE_ENV=development
# NODE_ENV=production
APP_NAME=PA_Valuetech_Server
PORT=5000
APP_PROTOCOL=http
APP_BASE_URL=localhost
DATA_LIMIT=10

# Opt-in for the hard-delete routes (DELETE /<resource>/delete/:id and
# /case/developer-delete/:id). They remove the row outright instead of setting
# deleted_at, so they stay disabled unless this is exactly "true", and are
# always disabled when NODE_ENV=production. Use the soft-delete routes instead.
ALLOW_HARD_DELETE=false

# pg_trgm similarity cutoff for the similar-case address search, 0 < t <= 1.
# Higher is stricter. Omit to use 0.65. Below about 0.6 every case in the same
# city matches, since the shared city/district/state/PIN tail alone scores ~0.59;
# above about 0.72 a retyped version of the same address stops matching.
ADDRESS_SIMILARITY_THRESHOLD=0.65

#database
# Pooled connection (Supabase's pooler, port 6543). Used by the app at runtime —
# @prisma/adapter-pg opens one pool per process against it.
DATABASE_URL=

# Direct connection (port 5432, bypassing the pooler). Used only by
# `prisma migrate` and `prisma generate`: migrations run DDL in a session that
# the transaction pooler cannot hold open. Read by prisma.config.ts, and
# required in production — see docker-compose.yaml.
DIRECT_URL=




#security
JWT_SECRET=
JWT_EXPIRY=
PEPPER_SECRET=
SALT_ROUNDS=


ENCRYPTION_KEY=
BLIND_INDEX_KEY=


#api configuration
# Megabytes, not bytes — interpolated as `${BODY_LIMIT}mb` in app.js.
BODY_LIMIT=10




#cross origin configuration
# Comma-separated list of exact origins allowed to send credentialed requests
# (see the allowlist in src/app.js). Compared literally, so no trailing slash
# and no wildcards: https://pa.nimitconsultancy.in and
# https://pa.nimitconsultancy.in/ are not the same string.
#
# Production must include the frontend origin:
#   ALLOWED_ORIGIN=https://pa.nimitconsultancy.in
#
# Leaving it out is one of two ways to produce the same silent failure — login
# succeeding and then every request 401ing — the other being a frontend served
# from outside nimitconsultancy.in, which SameSite=Strict blocks regardless of
# what this is set to.
ALLOWED_ORIGIN=http://localhost:5173
