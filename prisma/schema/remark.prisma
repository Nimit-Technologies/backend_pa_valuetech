model Remark {
  id      String @id @default(cuid())
  content String

  case_id String?
  case    Case?   @relation(fields: [case_id], references: [id], onDelete: SetNull)

  user_id       String?
  branch_id     String?
  department_id String?
  role_id       String?

  user       User?       @relation(fields: [user_id], references: [id], onDelete: SetNull)
  branch     Branch?     @relation(fields: [branch_id], references: [id], onDelete: SetNull)
  department Department? @relation(fields: [department_id], references: [id], onDelete: SetNull)
  role       Role?       @relation(fields: [role_id], references: [id], onDelete: SetNull)

  
  first_name      String
  employee_id     String
  branch_name     String
  department_name String
  role_name       String

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([case_id])
  @@index([user_id])
  @@index([branch_id])
  @@index([department_id])
  @@index([role_id])
  @@map("remarks")
}
