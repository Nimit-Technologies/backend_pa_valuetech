enum CaseAuditAction {
  create
  update
  assign
  reassign
  status_change
  soft_delete
  restore
}

model CaseUpdateHistory {
  id String @id @default(cuid())

  case_id       String
  updated_by_id String

  case       Case @relation(fields: [case_id], references: [id], onDelete: Restrict)
  updated_by User @relation(fields: [updated_by_id], references: [id], onDelete: Restrict)

  action CaseAuditAction

  from_status String?
  to_status   String?

  reason String?

  first_name  String
  employee_id String
  role        String
  department  String

  updated_at DateTime @default(now())

  @@index([case_id])
  @@index([updated_by_id])
  @@map("case_update_histories")
}
