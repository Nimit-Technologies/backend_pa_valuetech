model Department {
  id        String  @id @default(cuid())
  // Unique per branch, not globally: "sales" may exist in both "lucknow"
  // and "delhi". See @@unique below.
  name      String
  is_active Boolean @default(true)
  branch_id String
  branch    Branch  @relation(fields: [branch_id], references: [id], onDelete: Restrict)
  users      User[]
  roles      Role[]
  remarks    Remark[]
  history    Json      @default("[]")
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  // Names are lowercased by the zod schema before they are written, so this
  // behaves case-insensitively. It also serves the (name, branch_id)
  // lookups the old separate index covered.
  @@unique([name, branch_id])
  @@index([branch_id])
  @@map("departments")
}
