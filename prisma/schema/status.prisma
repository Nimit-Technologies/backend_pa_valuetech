model Status {
  id   String @id @default(cuid())
  code String @unique
  name String @unique

  is_active   Boolean @default(true)
  is_terminal Boolean @default(false)

  sort_order Int @default(0)

  cases       Case[]
  allocations Allocation[]

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  @@index([name])
  @@map("statuses")
}
