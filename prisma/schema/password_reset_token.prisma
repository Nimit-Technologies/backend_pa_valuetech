/// One row per outstanding password-reset request (forgot-password flow).
///
/// The token handed to the user is never stored — only its SHA-256 hash
/// (see src/features/users/utils/password.util.js). Rows are single-use
/// (deleted on a successful reset) and short-lived; stale rows can be swept
/// by purgeExpiredResetTokens() or a cron job.
///
/// Added for the password-management feature — run `npm run migrate` to
/// create the table before the /user/forgot-password and
/// /user/reset-password endpoints will work.
model PasswordResetToken {
  id         String    @id @default(cuid())
  user_id    String
  token_hash String    @unique
  expires_at DateTime
  used_at    DateTime?
  created_at DateTime  @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("password_reset_tokens")
}
