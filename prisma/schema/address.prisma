model Address {
  id       String  @id @default(cuid())
  lane     String?
  landmark String?
  city     String
  district String
  state    String
  pin_code String
  country  String  @default("India")

  search_text String?

  user       User?
  bank       Bank?
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
  cases      Case[]

  @@index([search_text(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("addresses")
}
