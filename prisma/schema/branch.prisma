model Branch {
  id String @id @default(cuid())

  name        String       @unique
  is_active   Boolean      @default(true)
  users       User[]
  departments Department[]
  banks       Bank[]
  remarks     Remark[]

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
  cases      Case[]

  @@index([name])
  @@map("branches")
}
